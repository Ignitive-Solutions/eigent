debug=false
url_prefix=/api

# ── Auth ────────────────────────────────────────────────────────────────────
# JWT signing key — change this to a strong random value in production
secret_key=change-me-to-a-strong-random-secret

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Docker Compose service name example: postgresql://postgres:password@db:5432/eigent
database_url=postgresql://postgres:123456@localhost:5432/eigent

# ── Redis ─────────────────────────────────────────────────────────────────────
# Main Redis (rate-limiting, cache)
# Docker Compose service name example: redis://redis:6379/0
redis_url=redis://localhost:6379/0

# Celery broker
celery_broker_url=redis://localhost:6379/0

# Celery result backend
celery_result_url=redis://localhost:6379/0

# WebSocket session store (separate DB index recommended)
SESSION_REDIS_URL=redis://localhost:6379/1

# ── Chat Share ────────────────────────────────────────────────────────────────
CHAT_SHARE_SECRET_KEY=put-your-secret-key-here
CHAT_SHARE_SALT=put-your-encode-salt-here

# ── Backend proxy ─────────────────────────────────────────────────────────────
# Internal URL of the backend container (used by the chat SSE proxy endpoint)
# In Docker Compose this is typically the service name + port
BACKEND_URL=http://backend:8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (in addition to localhost regex and Electron)
# Leave unset to use the built-in defaults: https://eigent-dev.ignitive.ai, app://*,  file://*
# CORS_ORIGINS=https://eigent-dev.ignitive.ai,https://app.ignitive.ai

# ── Trigger Schedule Poller ───────────────────────────────────────────────────
ENABLE_TRIGGER_SCHEDULE_POLLER_TASK=true
TRIGGER_SCHEDULE_POLLER_INTERVAL=1
TRIGGER_SCHEDULE_POLLER_BATCH_SIZE=100
TRIGGER_SCHEDULE_MAX_DISPATCH_PER_TICK=0

# ── Execution Timeout Checker ─────────────────────────────────────────────────
ENABLE_EXECUTION_TIMEOUT_CHECKER=true
EXECUTION_TIMEOUT_CHECKER_INTERVAL=1
EXECUTION_PENDING_TIMEOUT_SECONDS=60
EXECUTION_RUNNING_TIMEOUT_SECONDS=600