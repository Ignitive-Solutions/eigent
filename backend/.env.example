# Backend orchestration worker — environment variable reference
# Copy this file to .env and fill in the values before deploying.

# Python module search path (set to /app so imports resolve inside the container)
PYTHONPATH=/app

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Runtime environment label used in startup logs
ENVIRONMENT=production

# URL prefix for all API routes (leave empty for no prefix)
url_prefix=

# CORS allowed origins — comma-separated list of frontend origins
# Example: https://eigent-dev.ignitive.ai,https://app.ignitive.ai
CORS_ORIGINS=https://eigent-dev.ignitive.ai

# Server URL that the backend will call back to
SERVER_URL=http://server:8001
