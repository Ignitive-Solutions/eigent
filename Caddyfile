eigent-dev.ignitive.ai {
	# Automatic HTTPS via Let's Encrypt
	tls {
		protocols tls1.2 tls1.3
	}

	# Request body size limit: 100 MB (for file uploads)
	request_body {
		max_size 100MB
	}

	# WebSocket upgrade support for SSE/subscription endpoints
	@websocket {
		header Connection *Upgrade*
		header Upgrade    websocket
	}
	reverse_proxy @websocket server:8001 {
		transport http {
			dial_timeout 30s
			response_header_timeout 0
		}
	}

	# All other traffic proxied to the server container
	reverse_proxy server:8001 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
